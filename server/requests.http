### ==============================================================================
### Waste Journey Tracker - Phase 2A & 2B REST Client Collection
### ==============================================================================

@baseUrl = http://localhost:5000
@adminEmail = admin@wastejourney.local
@adminPassword = {{ADMIN_PASSWORD}}

### 1. Health Check
GET {{baseUrl}}/health

### 2. Login as Admin
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### 3. Change Password (Forced on first login)
@adminAccessToken = {{adminLogin.response.body.accessToken}}

POST {{baseUrl}}/auth/change-password
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "currentPassword": "{{adminPassword}}",
  "newPassword": "{{NEW_ADMIN_PASSWORD}}"
}

### 4. Get Current Profile (/me)
GET {{baseUrl}}/me
Authorization: Bearer {{adminAccessToken}}

### 5. Update Profile Name
PATCH {{baseUrl}}/me
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "name": "Anil Mehta (Chief Admin)"
}

### 6. Refresh Token Rotation
POST {{baseUrl}}/auth/refresh
X-Requested-With: XMLHttpRequest

### 7. List Users (Admin only)
GET {{baseUrl}}/users?status=all&limit=20
Authorization: Bearer {{adminAccessToken}}

### 8. List Master Routes (Accessible by all logged-in roles)
GET {{baseUrl}}/master/routes
Authorization: Bearer {{adminAccessToken}}

### 9. Get Settings (Admin & Head Officer)
GET {{baseUrl}}/settings
Authorization: Bearer {{adminAccessToken}}

### 10. Patch Settings (Admin only)
PATCH {{baseUrl}}/settings
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "variance_threshold_pct": 10.0
}

### ==============================================================================
### PHASE 2B: Core Business Logic Endpoints
### ==============================================================================

### 11. Create Batch (Admin only)
# @name createBatch
POST {{baseUrl}}/batches
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "batch_date": "2026-10-06",
  "waste_type": "WET",
  "quantity": 5000.0,
  "source_area": "City Center Market",
  "route_id": "<ROUTE_UUID>",
  "vehicle_id": "<VEHICLE_UUID>",
  "assignments": {
    "collection_user_id": "<COLLECTION_USER_UUID>",
    "transportation_user_id": "<TRANSPORT_USER_UUID>",
    "rts_user_id": "<RTS_USER_UUID>",
    "processing_user_id": "<PROCESS_USER_UUID>"
  }
}

### 12. List Batches (Filtered by role)
GET {{baseUrl}}/batches?limit=10&sort_by=created_at&sort_order=desc
Authorization: Bearer {{adminAccessToken}}

### 13. Get Batch Details & Timeline
@batchId = {{createBatch.response.body.batch.id}}
GET {{baseUrl}}/batches/{{batchId}}
Authorization: Bearer {{adminAccessToken}}

### 14. Get Batch QR Tracking Link
GET {{baseUrl}}/batches/{{batchId}}/qr
Authorization: Bearer {{adminAccessToken}}

### 15. Create Collection Stage Entry
POST {{baseUrl}}/batches/{{batchId}}/entries
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "stage": "COLLECTION",
  "event_time": "2026-10-06T08:00:00.000Z",
  "collection_area": "City Center Market",
  "route_id": "<ROUTE_UUID>",
  "vehicle_id": "<VEHICLE_UUID>",
  "waste_type": "WET",
  "quantity": 5000.0,
  "driver_id": "<DRIVER_UUID>",
  "note": "Morning pickup complete"
}

### 16. Correct Stage Entry
@entryId = <ENTRY_UUID>
POST {{baseUrl}}/entries/{{entryId}}/correct
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "reason": "Corrected tare weight deduction",
  "event_time": "2026-10-06T08:00:00.000Z",
  "collection_area": "City Center Market",
  "route_id": "<ROUTE_UUID>",
  "vehicle_id": "<VEHICLE_UUID>",
  "waste_type": "WET",
  "quantity": 4980.0,
  "driver_id": "<DRIVER_UUID>"
}

### 17. Admin Soft Delete Entry (Reverse order)
DELETE {{baseUrl}}/entries/{{entryId}}
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "reason": "Administrative entry rollback"
}

### 18. Personal Operator History
GET {{baseUrl}}/me/history?limit=20
Authorization: Bearer {{adminAccessToken}}
